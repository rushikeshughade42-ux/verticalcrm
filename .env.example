# TradeFlow WhatsApp-First CRM Environment Variables

# 1. Base App URL (Required for WhatsApp PDF & Quote Link generation)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 2. Google Gemini AI (Required for AI Quote Generation - Free key from https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# 3. Razorpay Payments (Required for WhatsApp UPI, GPay, PhonePe Billing - https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=placeholder_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_placeholder

# 4. Firebase Backend (virtical-crm - https://console.firebase.google.com)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=virtical-crm.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=virtical-crm
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=virtical-crm.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=589681611248
NEXT_PUBLIC_FIREBASE_APP_ID=1:589681611248:web:29473d27dcecfcd9708d35
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-LDN2G4W3DX
